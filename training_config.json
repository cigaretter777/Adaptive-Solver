{
  "model_name": "Qwen/Qwen2.5-7B-Instruct",
  "learning_rate": 5e-6,
  "batch_size": 4,
  "num_epochs": 10,
  "max_steps": 100,
  "output_dir": "./outputs/gsm8k_training",
  "save_steps": 5,
  "gsm8k_path": "gsm8k.json",
  "use_sample_data": true,
  "data_size": 100,
  "gradient_accumulation_steps": 2,

  "GRPO": {
    "group_size": 4,
    "kl_penalty": 0.1,
    "clip_range": 0.2,
    "gamma": 0.99,
    "gae_lambda": 0.95
  },

  "LoRA": {
    "lora_rank": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "target_modules": ["q_proj", "v_proj"]
  },

  "reward_weights": {
    "accuracy": 1.0,
    "efficiency": 0.5,
    "safety": 0.3,
    "consistency": 0.2
  },

  "training": {
    "warmup_steps": 100,
    "logging_steps": 10,
    "eval_steps": 50,
    "max_grad_norm": 1.0
  },

  "data": {
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1,
    "shuffle": true,
    "seed": 42
  }
}
